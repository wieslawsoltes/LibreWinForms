<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>System.Drawing.Common</AssemblyName>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <RootNamespace>System.Drawing</RootNamespace>
    <PackageId>ProGPU.System.Drawing.Common</PackageId>
    <Description>ProGPU-backed portable System.Drawing.Common compatibility shim.</Description>
    <PackageTags>progpu;system.drawing;drawing;compatibility;cross-platform</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageWriteSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ProGpuSourceRoot)/src/ProGPU.Backend/ProGPU.Backend.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)/src/ProGPU.Backend.Native/ProGPU.Backend.Native.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)/src/ProGPU.Vector/ProGPU.Vector.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)/src/ProGPU.Text/ProGPU.Text.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)/src/ProGPU.Scene/ProGPU.Scene.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)/src/ProGPU.Scene.Native/ProGPU.Scene.Native.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)/src/SkiaSharp/SkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="System.Drawing.Common.Tests, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="System.Drawing.Common.Benchmarks, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Tests.Headless, PublicKey=$(ProGPUPublicKey)" />
  </ItemGroup>
</Project>
