<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>LibreWinForms.Sdk</PackageId>
    <Title>LibreWinForms SDK</Title>
    <Description>SDK package for cross-platform WinForms applications running on canonical WinForms source, Silk.NET, and ProGPU.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>librewinforms;winforms;sdk;progpu;silk.net;cross-platform;source-built</PackageTags>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <LibreWinFormsCanonicalPackageVersion Condition="'$(LibreWinFormsCanonicalPackageVersion)' == ''">$(PackageVersion)</LibreWinFormsCanonicalPackageVersion>
    <LibreWinFormsProGpuBackendPackageVersion Condition="'$(LibreWinFormsProGpuBackendPackageVersion)' == ''">$(PackageVersion)</LibreWinFormsProGpuBackendPackageVersion>
    <LibreWinFormsProGpuPackageVersion Condition="'$(LibreWinFormsProGpuPackageVersion)' == ''">0.1.0-preview.65</LibreWinFormsProGpuPackageVersion>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectLibreWinFormsSdkVersionFile;CollectLibreWinFormsSdkAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk\" />
    <None Include="targets\**\*" Pack="true" PackagePath="targets\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <_LibreWinFormsAnalyzerProject Include="../System.Windows.Forms.Analyzers/src/System.Windows.Forms.Analyzers.csproj;
                                         ../System.Windows.Forms.Analyzers.CSharp/src/System.Windows.Forms.Analyzers.CSharp.csproj;
                                         ../System.Windows.Forms.Analyzers.VisualBasic/src/System.Windows.Forms.Analyzers.VisualBasic.vbproj" />
    <ProjectReference Include="@(_LibreWinFormsAnalyzerProject)"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CollectLibreWinFormsSdkAnalyzers" DependsOnTargets="ResolveProjectReferences">
    <!-- Reuse the original analyzer projects' owned assembly/satellite outputs;
         do not bundle Roslyn or test/runtime dependencies into the SDK. -->
    <MSBuild Projects="@(_LibreWinFormsAnalyzerProject)"
             Targets="GetPackageContent"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_LibreWinFormsAnalyzerPackageFile" />
    </MSBuild>
    <Error Condition="'@(_LibreWinFormsAnalyzerPackageFile)' == ''"
           Text="The original WinForms analyzer payload was not produced." />
    <Error Condition="!Exists('%(_LibreWinFormsAnalyzerPackageFile.Identity)')"
           Text="An original WinForms analyzer payload file is missing: %(_LibreWinFormsAnalyzerPackageFile.Identity)" />
    <ItemGroup>
      <_LibreWinFormsAnalyzerAssembly Include="@(_LibreWinFormsAnalyzerPackageFile)"
                                     Condition="'%(_LibreWinFormsAnalyzerPackageFile.Filename)' == 'System.Windows.Forms.Analyzers' Or '%(_LibreWinFormsAnalyzerPackageFile.Filename)' == 'System.Windows.Forms.Analyzers.CSharp' Or '%(_LibreWinFormsAnalyzerPackageFile.Filename)' == 'System.Windows.Forms.Analyzers.VisualBasic'">
        <_IsAssembly Condition="'%(_LibreWinFormsAnalyzerPackageFile.Extension)' == '.dll'">true</_IsAssembly>
      </_LibreWinFormsAnalyzerAssembly>
    </ItemGroup>
    <Error Condition="'@(_LibreWinFormsAnalyzerAssembly->WithMetadataValue('_IsAssembly', 'true')->Count())' != '3'"
           Text="The SDK requires all three original shared, CSharp, and VisualBasic analyzer assemblies." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_LibreWinFormsAnalyzerPackageFile)"
                              Condition="'%(_LibreWinFormsAnalyzerPackageFile.Extension)' == '.dll'">
        <PackagePath>$([System.String]::Copy('%(_LibreWinFormsAnalyzerPackageFile.PackagePath)').Replace('sdk/analyzers/', 'analyzers/'))/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="CollectLibreWinFormsSdkVersionFile">
    <PropertyGroup>
      <_LibreWinFormsSdkVersionFile>$(IntermediateOutputPath)LibreWinForms.Sdk.Versions.props</_LibreWinFormsSdkVersionFile>
    </PropertyGroup>
    <ItemGroup>
      <_LibreWinFormsSdkVersionLine Include="&lt;Project&gt;" />
      <_LibreWinFormsSdkVersionLine Include="  &lt;PropertyGroup&gt;" />
      <_LibreWinFormsSdkVersionLine Include="    &lt;LibreWinFormsPackagedRuntimeVersion&gt;$(LibreWinFormsCanonicalPackageVersion)&lt;/LibreWinFormsPackagedRuntimeVersion&gt;" />
      <_LibreWinFormsSdkVersionLine Include="    &lt;LibreWinFormsPackagedProGpuBackendVersion&gt;$(LibreWinFormsProGpuBackendPackageVersion)&lt;/LibreWinFormsPackagedProGpuBackendVersion&gt;" />
      <_LibreWinFormsSdkVersionLine Include="    &lt;LibreWinFormsPackagedProGpuVersion&gt;$(LibreWinFormsProGpuPackageVersion)&lt;/LibreWinFormsPackagedProGpuVersion&gt;" />
      <_LibreWinFormsSdkVersionLine Include="  &lt;/PropertyGroup&gt;" />
      <_LibreWinFormsSdkVersionLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_LibreWinFormsSdkVersionFile)"
                      Lines="@(_LibreWinFormsSdkVersionLine)"
                      Overwrite="true" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_LibreWinFormsSdkVersionFile)"
                              PackagePath="Sdk/LibreWinForms.Sdk.Versions.props" />
    </ItemGroup>
  </Target>
</Project>
