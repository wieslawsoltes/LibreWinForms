<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetCurrent)</TargetFramework>
    <AssemblyName>LibreWinForms.CanonicalLifecycle.Tests</AssemblyName>
    <Product>LibreWinForms canonical API contracts</Product>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <LibreWinFormsUseProGpuSystemDrawing>true</LibreWinFormsUseProGpuSystemDrawing>
    <LibreWinFormsReferenceMode>Project</LibreWinFormsReferenceMode>
    <MicrosoftNETCoreAppRefPackageVersion></MicrosoftNETCoreAppRefPackageVersion>
  </PropertyGroup>

  <!-- These actual native CPU controls require an explicitly staged qualified
       runtime. Product adapters and managed source controls compile normally. -->
  <PropertyGroup Condition="'$(LibreWinFormsTestNativeEditRuntime)' == 'true'">
    <DefineConstants>$(DefineConstants);LIBREWINFORMS_TEST_NATIVE_EDIT_RUNTIME</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../../packaging/LibreWinForms.Sdk.SourceFirstSmoke/CanonicalApiContracts.cs" Link="CanonicalApiContracts.cs" />
    <Compile Include="../../../LibreWinForms.ProGPU/ProGpuTextRendererService.cs" Link="ProGpuTextRendererService.cs" />
    <Compile Include="../../../LibreWinForms.ProGPU/ProGpuEditWordBoundaryCapture.cs" Link="ProGpuEditWordBoundaryCapture.cs" />
    <Compile Include="../../../LibreWinForms.ProGPU/NativePointerInput.cs" Link="NativePointerInput.cs" />
    <Compile Include="../../../LibreWinForms.ProGPU/ProGpuDragCancellation.cs" Link="ProGpuDragCancellation.cs" />
    <Compile Include="../../../LibreWinForms.ProGPU/tests/NativePointerTestContext.cs" Link="NativePointerTestContext.cs" />
    <Compile Include="../../../Common/src/TextRendererMargins.cs" Link="TextRendererMargins.cs" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.DotNet.XUnitV3Extensions" />
    <ProjectReference Include="..\..\..\LibreWinForms.Platform\LibreWinForms.Platform.csproj" />
    <ProjectReference Include="..\..\..\System.Windows.Forms\System.Windows.Forms.csproj"
                      AdditionalProperties="LibreWinFormsUseProGpuSystemDrawing=true;LibreWinFormsReferenceMode=Project;MicrosoftNETCoreAppRefPackageVersion=" />
  </ItemGroup>

</Project>
