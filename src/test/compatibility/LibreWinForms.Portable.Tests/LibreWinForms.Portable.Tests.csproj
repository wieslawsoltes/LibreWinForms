<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <LibreWinFormsReferenceMode Condition="'$(LibreWinFormsReferenceMode)' == ''">Project</LibreWinFormsReferenceMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\LibreWinForms.Portable\LibreWinForms.System.Windows.Forms\LibreWinForms.System.Windows.Forms.csproj"
                      AdditionalProperties="LibreWinFormsReferenceMode=$(LibreWinFormsReferenceMode);LibreWinFormsBridgePackageVersion=$(LibreWinFormsBridgePackageVersion);LibreWinFormsProGpuPackageVersion=$(LibreWinFormsProGpuPackageVersion)">
      <Aliases>global,PortableWinForms</Aliases>
    </ProjectReference>
  </ItemGroup>
</Project>
