<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>LibreWinForms.WindowsFormsIntegration</PackageId>
    <Title>LibreWinForms WindowsFormsIntegration</Title>
    <AssemblyName>WindowsFormsIntegration</AssemblyName>
    <RootNamespace>System.Windows.Forms.Integration</RootNamespace>
    <Description>LibreWinForms portable WindowsFormsIntegration host surface for LibreWPF and ProGPU-backed WinForms content.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>librewinforms;windowsformsintegration;librewpf;progpu;cross-platform</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly Condition="Exists('..\..\..\..\ProGPU\eng\ProGPU.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('..\..\..\..\ProGPU\eng\ProGPU.snk')">..\..\..\..\ProGPU\eng\ProGPU.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS0067;CS1591;IDE0005;IDE0073;IDE1006</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <_LibreWpfManagedAssemblyRoot>$(MSBuildThisFileDirectory)..\..\..\..\..\artifacts\bin\</_LibreWpfManagedAssemblyRoot>
    <_LibreWpfManagedAssemblyRoot Condition="'$(LibreWpfManagedAssemblyRoot)' != ''">$(LibreWpfManagedAssemblyRoot)</_LibreWpfManagedAssemblyRoot>
    <_LibreWpfUseManagedAssemblyRoot Condition="'$(LibreWpfManagedAssemblyRoot)' != ''">true</_LibreWpfUseManagedAssemblyRoot>
    <_LibreWpfUseManagedAssemblyRoot Condition="'$(_LibreWpfUseManagedAssemblyRoot)' == '' And Exists('$(_LibreWpfManagedAssemblyRoot)WindowsBase\$(Configuration)\$(TargetFramework)\WindowsBase.dll') And Exists('$(_LibreWpfManagedAssemblyRoot)System.Xaml\$(Configuration)\$(TargetFramework)\System.Xaml.dll') And Exists('$(_LibreWpfManagedAssemblyRoot)PresentationCore\$(Configuration)\$(TargetFramework)\PresentationCore.dll') And Exists('$(_LibreWpfManagedAssemblyRoot)PresentationFramework\$(Configuration)\$(TargetFramework)\PresentationFramework.dll')">true</_LibreWpfUseManagedAssemblyRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreWPF.Interop"
                      Version="$(LibreWinFormsBridgePackageVersion)"
                      Condition="'$(LibreWinFormsReferenceMode)' != 'Project'" />
    <PackageReference Include="LibreWPF.ProGPU"
                      Version="$(LibreWinFormsBridgePackageVersion)"
                      Condition="'$(LibreWinFormsReferenceMode)' != 'Project'" />
    <PackageReference Include="LibreWPF.Transport" Version="$(LibreWinFormsBridgePackageVersion)" />
    <PackageReference Include="ProGPU.System.Drawing.Common"
                      Version="$(LibreWinFormsBridgePackageVersion)"
                      Condition="'$(LibreWinFormsReferenceMode)' != 'Project'" />
    <ProjectReference Include="..\LibreWinForms.System.Windows.Forms\LibreWinForms.System.Windows.Forms.csproj" />
    <ProjectReference Include="..\..\..\..\ProGPU\src\ProGPU.Wpf.Interop\ProGPU.Wpf.Interop.csproj"
                      Condition="'$(LibreWinFormsReferenceMode)' == 'Project'" />
    <ProjectReference Include="..\..\..\..\ProGPU\src\System.Drawing.Common\System.Drawing.Common.csproj"
                      Condition="'$(LibreWinFormsReferenceMode)' == 'Project'" />
    <ProjectReference Include="..\..\..\..\..\src\ProGPU.Wpf\ProGPU.Wpf.csproj"
                      Condition="'$(LibreWinFormsReferenceMode)' == 'Project'" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LibreWpfUseManagedAssemblyRoot)' == 'true'">
    <Reference Include="WindowsBase" HintPath="$(_LibreWpfManagedAssemblyRoot)WindowsBase\$(Configuration)\$(TargetFramework)\WindowsBase.dll" Private="false" />
    <Reference Include="System.Xaml" HintPath="$(_LibreWpfManagedAssemblyRoot)System.Xaml\$(Configuration)\$(TargetFramework)\System.Xaml.dll" Private="false" />
    <Reference Include="PresentationCore" HintPath="$(_LibreWpfManagedAssemblyRoot)PresentationCore\$(Configuration)\$(TargetFramework)\PresentationCore.dll" Private="false" />
    <Reference Include="PresentationFramework" HintPath="$(_LibreWpfManagedAssemblyRoot)PresentationFramework\$(Configuration)\$(TargetFramework)\PresentationFramework.dll" Private="false" />
  </ItemGroup>
</Project>
