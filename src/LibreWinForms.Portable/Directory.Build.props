<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <LibreWinFormsVersion Condition="'$(LibreWinFormsVersion)' == ''">0.1.0-preview.41</LibreWinFormsVersion>
    <LibreWinFormsBridgePackageVersion Condition="'$(LibreWinFormsBridgePackageVersion)' == ''">$(LibreWinFormsVersion)</LibreWinFormsBridgePackageVersion>
    <LibreWinFormsProGpuPackageVersion Condition="'$(LibreWinFormsProGpuPackageVersion)' == ''">0.1.0-preview.47</LibreWinFormsProGpuPackageVersion>
    <Version Condition="'$(Version)' == ''">$(LibreWinFormsVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>

    <Authors>Wieslaw Soltes</Authors>
    <Company>LibreWinForms</Company>
    <Product>LibreWinForms</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wieslawsoltes/winforms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wieslawsoltes/winforms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>librewinforms;progpu;silk.net;winforms;cross-platform</PackageTags>
    <PackageReleaseNotes>Aligns LibreWinForms 0.1.0-preview.41 with immutable LibreWPF 0.1.0-preview.41 and ProGPU 0.1.0-preview.47; builds unchanged .NET WinForms templates through LibreWinForms.Sdk with Application startup compatibility and ProGPU-backed System.Drawing cardinal curves; validates hosted drawing contexts through the typed ProGpuDrawingContextState conversion, rejects invalid native contexts and non-finite transforms, and preserves immutable outer/client transform composition without reflection; consumes ProGPU's compact retained picture commands, glyph/scalar/layer records, specialized single-run text blobs, and reusable nonblocking image readback without a downstream compatibility path; validates native popup-local Cocoa input through the same typed coordinate conversion used by production hosts; bounds retained formatted-text and text drawing-group caches to reduce the measured churn working set by 81.3% and residual retention by 60.7% without increasing steady-frame allocations; reuses retained designer adorners and guards render-cache growth under repeated design-surface interaction; persists versioned, bounded designer SerializationStore payloads and content component collections across save/load cycles; preserves Project Explorer and designer double-click counts; keeps MenuStrip, ToolStrip, context menus, and dropdowns correctly positioned and interactive; and retains typed X11/XWayland positioning, movement, dispatcher-pump, text, image, and scene-performance behavior.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
</Project>
