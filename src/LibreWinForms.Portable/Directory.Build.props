<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <LibreWinFormsVersion Condition="'$(LibreWinFormsVersion)' == ''">0.1.0-preview.28</LibreWinFormsVersion>
    <LibreWinFormsBridgePackageVersion Condition="'$(LibreWinFormsBridgePackageVersion)' == ''">$(LibreWinFormsVersion)</LibreWinFormsBridgePackageVersion>
    <LibreWinFormsProGpuPackageVersion Condition="'$(LibreWinFormsProGpuPackageVersion)' == ''">0.1.0-preview.27</LibreWinFormsProGpuPackageVersion>
    <Version Condition="'$(Version)' == ''">$(LibreWinFormsVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>

    <Authors>Wieslaw Soltes</Authors>
    <Company>LibreWinForms</Company>
    <Product>LibreWinForms</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wieslawsoltes/winforms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wieslawsoltes/winforms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>librewinforms;progpu;silk.net;winforms;cross-platform</PackageTags>
    <PackageReleaseNotes>Aligns LibreWinForms and LibreWPF 0.1.0-preview.28 with immutable ProGPU 0.1.0-preview.27; builds unchanged .NET WinForms template projects through LibreWinForms.Sdk without requiring a Windows TFM; generates the standard ApplicationConfiguration entry point and WinForms global imports; preserves hosted double-click counts for Project Explorer and designer interactions; gives MenuStrip, ToolStrip, and context dropdowns correctly positioned and interactive native popup surfaces; and retains typed designer, keyboard, layout, bounded-memory, and glyph-scrolling behavior.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
</Project>
