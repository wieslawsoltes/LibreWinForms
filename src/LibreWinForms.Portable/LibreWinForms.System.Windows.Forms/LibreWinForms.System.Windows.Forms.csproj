<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>LibreWinForms.System.Windows.Forms</PackageId>
    <Title>LibreWinForms System.Windows.Forms</Title>
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <Description>LibreWinForms portable System.Windows.Forms API surface backed by ProGPU/Silk.NET-compatible services.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>librewinforms;winforms;progpu;silk.net;cross-platform</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly Condition="Exists('$(LibreWinFormsProGpuSourceRoot)eng\ProGPU.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(LibreWinFormsProGpuSourceRoot)eng\ProGPU.snk')">$(LibreWinFormsProGpuSourceRoot)eng\ProGPU.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS1591;CA1051;CA1815;IDE0005;IDE0073;IDE0300;IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <PackageReference Include="LibreWPF.Interop"
                      Version="$(LibreWinFormsProGpuPackageVersion)"
                      Condition="'$(LibreWinFormsReferenceMode)' != 'Project'" />
    <PackageReference Include="ProGPU.System.Drawing.Common"
                      Version="$(LibreWinFormsProGpuPackageVersion)"
                      Condition="'$(LibreWinFormsReferenceMode)' != 'Project'" />
    <ProjectReference Include="$(LibreWinFormsProGpuSourceRoot)src\ProGPU.Wpf.Interop\ProGPU.Wpf.Interop.csproj"
                      Condition="'$(LibreWinFormsReferenceMode)' == 'Project'" />
    <ProjectReference Include="$(LibreWinFormsProGpuSourceRoot)src\System.Drawing.Common\System.Drawing.Common.csproj"
                      Condition="'$(LibreWinFormsReferenceMode)' == 'Project'" />
  </ItemGroup>
</Project>
