<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <LibreWinFormsReferenceMode>Project</LibreWinFormsReferenceMode>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="WindowsBase" HintPath="..\..\..\..\artifacts\bin\WindowsBase\$(Configuration)\$(TargetFramework)\WindowsBase.dll" Private="true" />
    <Reference Include="System.Xaml" HintPath="..\..\..\..\artifacts\bin\System.Xaml\$(Configuration)\$(TargetFramework)\System.Xaml.dll" Private="true" />
    <Reference Include="PresentationCore" HintPath="..\..\..\..\artifacts\bin\PresentationCore\$(Configuration)\$(TargetFramework)\PresentationCore.dll" Private="true" />
    <Reference Include="PresentationFramework" HintPath="..\..\..\..\artifacts\bin\PresentationFramework\$(Configuration)\$(TargetFramework)\PresentationFramework.dll" Private="true" />
    <Reference Include="PresentationUI" HintPath="..\..\..\..\artifacts\bin\PresentationUI\$(Configuration)\$(TargetFramework)\PresentationUI.dll" Private="true" />
    <Reference Include="ReachFramework" HintPath="..\..\..\..\artifacts\bin\ReachFramework\$(Configuration)\$(TargetFramework)\ReachFramework.dll" Private="true" />
    <Reference Include="System.Windows.Controls.Ribbon" HintPath="..\..\..\..\artifacts\bin\System.Windows.Controls.Ribbon\$(Configuration)\$(TargetFramework)\System.Windows.Controls.Ribbon.dll" Private="true" />
    <Reference Include="UIAutomationProvider" HintPath="..\..\..\..\artifacts\bin\UIAutomationProvider\$(Configuration)\$(TargetFramework)\UIAutomationProvider.dll" Private="true" />
    <Reference Include="UIAutomationTypes" HintPath="..\..\..\..\artifacts\bin\UIAutomationTypes\$(Configuration)\$(TargetFramework)\UIAutomationTypes.dll" Private="true" />
    <ProjectReference Include="$(LibreWinFormsProGpuSourceRoot)src\ProGPU.Scene\ProGPU.Scene.csproj" />
    <ProjectReference Include="$(LibreWinFormsProGpuSourceRoot)src\ProGPU.DirectX\ProGPU.DirectX.csproj" />
    <ProjectReference Include="$(LibreWinFormsProGpuSourceRoot)src\ProGPU.Wpf.Interop\ProGPU.Wpf.Interop.csproj" />
    <ProjectReference Include="$(LibreWinFormsProGpuSourceRoot)src\System.Drawing.Common\System.Drawing.Common.csproj" />
    <ProjectReference Include="..\..\src\LibreWinForms.Portable\LibreWinForms.System.Windows.Forms\LibreWinForms.System.Windows.Forms.csproj"
                      AdditionalProperties="LibreWinFormsReferenceMode=Project" />
    <ProjectReference Include="..\..\src\LibreWinForms.Portable\LibreWinForms.WindowsFormsIntegration\LibreWinForms.WindowsFormsIntegration.csproj"
                      AdditionalProperties="LibreWinFormsReferenceMode=Project" />
  </ItemGroup>
</Project>
