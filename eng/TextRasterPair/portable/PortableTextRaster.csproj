<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(PreparedAssemblyDirectory)' != ''">
    <Reference Include="$(PreparedAssemblyDirectory)/*.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(PreparedAssemblyDirectory)' == ''">
    <PackageReference Include="LibreWinForms.ProGPU" Version="0.1.0-source-first" />
    <PackageReference Include="ProGPU.System.Drawing.Common" Version="0.1.0-source-first" />
  </ItemGroup>
</Project>
