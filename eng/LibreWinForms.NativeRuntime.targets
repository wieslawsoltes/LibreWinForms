<Project>
  <!-- Project applications use the exact whole-qualified producer's staged
       native payload. NuGet applications retain ordinary runtime resolution. -->
  <PropertyGroup>
    <LibreWinFormsUseSourceNativeRuntime Condition="'$(LibreWinFormsReferenceMode)' == 'Project' And '$(LibreWinFormsUseProGpuSystemDrawing)' == 'true'">true</LibreWinFormsUseSourceNativeRuntime>
    <_LibreWinFormsSelectNativeRuntime Condition="'$(_LibreWinFormsNativeRuntimeImported)' != 'true' And '$(LibreWinFormsUseSourceNativeRuntime)' == 'true' And '$(LibreWinFormsReferenceMode)' != 'Package' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(IsTestProject)' == 'true')">true</_LibreWinFormsSelectNativeRuntime>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_LibreWinFormsSelectNativeRuntime)' == 'true'">
    <_LibreWinFormsNativeProGpuRoot Condition="'$(LibreWinFormsProGpuSourceRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(LibreWinFormsProGpuSourceRoot)'))</_LibreWinFormsNativeProGpuRoot>
    <_LibreWinFormsNativeProGpuRoot Condition="'$(_LibreWinFormsNativeProGpuRoot)' == '' And '$(ProGpuSourceRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(ProGpuSourceRoot)'))</_LibreWinFormsNativeProGpuRoot>
    <_LibreWinFormsNativeRuntimeRoot Condition="'$(ProGpuNativeRuntimeRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(ProGpuNativeRuntimeRoot)'))</_LibreWinFormsNativeRuntimeRoot>
    <_LibreWinFormsNativeRuntimeRoot Condition="'$(_LibreWinFormsNativeRuntimeRoot)' == '' And '$(_LibreWinFormsNativeProGpuRoot)' != ''">$(_LibreWinFormsNativeProGpuRoot)artifacts/progpu-native/package/</_LibreWinFormsNativeRuntimeRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(_LibreWinFormsSelectNativeRuntime)' == 'true' And '$(_LibreWinFormsNativeRuntimeRoot)' != ''">
    <_LibreWinFormsNativePayload Include="$(_LibreWinFormsNativeRuntimeRoot)runtimes/*/native/**/*"
                               Exclude="$(_LibreWinFormsNativeRuntimeRoot)runtimes/*/native/sdk/**/*"
                               Condition="'$(RuntimeIdentifier)' == ''" />
    <_LibreWinFormsNativePayload Include="$(_LibreWinFormsNativeRuntimeRoot)runtimes/$(RuntimeIdentifier)/native/**/*"
                               Exclude="$(_LibreWinFormsNativeRuntimeRoot)runtimes/$(RuntimeIdentifier)/native/sdk/**/*"
                               Condition="'$(RuntimeIdentifier)' != ''" />
    <Content Include="@(_LibreWinFormsNativePayload)" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true">
      <Link Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::MakeRelative('$(_LibreWinFormsNativeRuntimeRoot)', '%(FullPath)'))</Link>
      <!-- RID-specific NuGet native dependencies are flattened alongside the
           executable. Keep the original libraries together for loader identity. -->
      <Link Condition="'$(RuntimeIdentifier)' != ''">$([MSBuild]::MakeRelative('$(_LibreWinFormsNativeRuntimeRoot)runtimes/$(RuntimeIdentifier)/native', '%(FullPath)'))</Link>
    </Content>
  </ItemGroup>
  <PropertyGroup>
    <_LibreWinFormsNativeRuntimeImported Condition="'$(_LibreWinFormsSelectNativeRuntime)' == 'true'">true</_LibreWinFormsNativeRuntimeImported>
  </PropertyGroup>
</Project>
