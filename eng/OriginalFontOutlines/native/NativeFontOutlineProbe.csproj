<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProGpuSourceRoot)' != ''">
    <ProjectReference Include="$(ProGpuSourceRoot)/src/ProGPU.Backend.Native/ProGPU.Backend.Native.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuSourceRoot)' == ''">
    <PackageReference Include="ProGPU.Backend.Native" Version="$(ProducerVersion)" />
  </ItemGroup>
</Project>
